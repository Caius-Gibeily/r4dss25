aes(x=d),
fill = "grey", alpha = 0.5)
bootstrapped <-  map(1:10000, \(i) {
dat_boot <- boot(dat) %>% summarise(d = cohens_d(n(),n(),
mean(x1),mean(x2),sd(x1),sd(x2)))}
) |>
list_rbind(names_to = "iteration") %>% mutate(
color = ifelse(d < quantile(permuted$d, 0.975),
"grey","lightblue")
)
bootstrapped

library(patchwork)
cov_scale <- function(dat,scale) {
dat |> summarize(
scale = scale,
cov_xy = cov(dat[[1]],dat[[2]]*scale),
) |> tibble()
}
generate_data <- function(n1,m1,sd1, n2,m2,sd2) {
tibble(
x1 = rnorm(n1,m1,sd1),
x2 = rnorm(n2,m2,sd2)
)
}
dat <- generate_data(100,10,25,100,10,25)

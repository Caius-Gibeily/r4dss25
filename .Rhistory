test_dat <- blink_times
stan_dat <- list(
S = length(unique(test_dat$ind)),
N_total = test_dat %>% count() %>% pull(),
M = 40,
L_factor = 1.4,
t_ev = test_dat$t_blink,
dt = test_dat$dt,
s_id = test_dat$ind,
mu_rho_pop = log(30),
mu_rho_subj = log(20)
)
fit2 <- stan(
file = "hsgp_multi-group.stan",
data = stan_dat,
chains = 4,
iter = 2000,
warmup = 1000,
control = list(adapt_delta = 0.95, max_treedepth = 12)
)
fit2 <- stan(
file = "hsgp_updated.stan",
data = stan_dat,
chains = 4,
iter = 2000,
warmup = 1000,
control = list(adapt_delta = 0.95, max_treedepth = 12)
)

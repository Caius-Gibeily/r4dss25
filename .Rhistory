library(janitor)
to_scale <- function(col) {
case_when({{col}} == "unusable" ~ 1,
{{col}} == "very low" ~ 2,
{{col}} == "low" ~ 2,
{{col}} == "moderate" ~ 3,
{{col}} == "medium" ~ 3,
{{col}} == "high" ~ 4,
is.na({{col}}) ~ 0,
.default = 0)
}
#1967903 - deleted due to edf save error
quals <- read_csv("et_data/ET_usability.csv") %>% clean_names()
quals <- quals %>% mutate(
t1_qual = str_to_lower(t1_qual) %>% to_scale,
t2_qual = str_to_lower(t2_qual) %>% to_scale)
qual1_n <- quals %>% group_by(dx) %>% count(t1_qual)
qual2_n <- quals %>% group_by(dx) %>% count(t2_qual)
qual_n <- qual1_n %>% full_join(qual2_n,
by = c("t1_qual" = "t2_qual", "dx")) %>%
pivot_longer(cols = starts_with("n"), values_to = "count",
names_to = "session") %>% rename(qual = t1_qual)
ggplot(qual_n,aes(x = qual, y = count, group = interaction(session,dx),
fill = interaction(session,dx))) +
geom_col(position = "stack") +
scale_fill_discrete(labels = c("ASD - Session 1", "ASD - Session 2",
"TD - Session 1", "TD - Session 2")) +
labs(x = "Quality", y = "Frequency") +
theme_minimal()

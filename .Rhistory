simulate_blinks <- function(trace,
prior_k, offset) {
k <- 12
blink_times <- tibble(
t_blink = 0.1,
dt = 10^offset
)
rate_t <- trace$rate
xseq <- trace$x
t_unit <- xseq[2] - xseq[1]
for (xi in 1:length(xseq)) {
last_blink <- tail(blink_times$t_blink,1)
dt = xseq[xi] - last_blink
blink_prob <- dgamma(dt, shape = k, rate = rate_t[xi]) /
(1 - pgamma(dt, shape = k, rate = rate_t[xi]))
if (runif(1) <= blink_prob * t_unit) {
blink_times <- blink_times %>% add_row(t_blink = xseq[xi],
dt = xseq[xi] - last_blink)
} else next
}
return(blink_times)
}

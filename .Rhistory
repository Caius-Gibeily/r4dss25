chi_sq_fast <- function(data, group, category, count) {
# 1. Convert to a matrix (contingency table)
m <- xtabs(as.formula(paste(substitute(count), "~", substitute(group), "+", substitute(category))), data = data)
# 2. Calculate expected values using the outer product of margins
expected <- outer(rowSums(m), colSums(m)) / sum(m)
# 3. Compute the statistic
sum((m - expected)^2 / expected)
}
chi_sq_fast
chi_sq_fast(s_atl,phone,laptop,n)
chi_sq_fast(s_atl %>% count(phone,laptop),phone,laptop,n)
chisq.test(s_atl$phone,s_atl$laptop)
chisq.test(s_atl$phone,s_atl$laptop,correct = FALSE)

generate_corr_hist <- function(n, nruns = 1000) {
chance_corrs <- map(1:nruns, \(i) {
df <- generate_data(n1 = n, mean1 = 0,
sd1 = 5, ,
n2 = n,
mean2 = 0,
sd2 = 5)
cor(df[[1]], df[[2]])
}) |> as.numeric()
tibble(corrs = chance_corrs)
}
generate_corr_hist(100)

generate_multibinom <- function(p_iphone, p_mac, p_iphone_mac, n) {
n_iphone <- round(p_iphone * n)
n_android <- n - n_iphone
n_mac <- round(p_mac * n)
n_iphone_mac <- round(p_iphone * n * p_iphone_mac)
n_android_mac <- n_mac - iphone_mac
laptops_iphone <- sample(rep(c("Mac", "PC"), c(n_iphone_mac, n_iphone - n_iphone_mac)))
laptops_android <- sample(rep(c("Mac", "PC"), c(n_android_mac, n_android - n_android_mac)))
tibble(
phone = rep(c("iPhone", "Android"), c(n_iphone, n_android)),
laptop = c(laptops_iphone, laptops_android)
)
}

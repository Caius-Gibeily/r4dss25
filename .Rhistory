}
pval <- t.test(x, y, var.equal = TRUE)$p.value
tibble(n_var = i, total_tests = total_tests, iteration = j, truth = truth[k], p = pval)
}) %>% list_rbind()
}) %>% list_rbind()
}) %>% list_rbind()
results
}

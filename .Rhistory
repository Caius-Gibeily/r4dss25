calc_q <- function(data,group,y) {
sum <- data |>
group_by(group) |>
summarize(
mean = mean({{y}}),
var = var({{y}}),
n = n(),
) |> summarize(diff = max(mean) - min(mean),
n = mean(n),
mse = mean(var),
denom = sqrt(mse / n),
q = diff / denom) |> pull(q)
}
q_dist <- map(1:4000, \(x) {
dat %>% break_assoc(y)%>%
calc_q(group,shuffled)
}) %>% list_cbind()
q_dist <- map(1:40, \(x) {
dat %>% break_assoc(y) %>%
calc_q(group,shuffled)
})
q_dist

# Attach p-values for max-d via permutation
pairwise_cd <- function(data, groups, values){
sum <- data |>
group_by({{groups}}) |>
summarize(mean = mean({{values}}),
var = var({{values}}),
n = n()) |>
rename(group = {{groups}})
cross_join(sum, sum,
suffix = c("1","2")) |>
filter(group1 < group2) |>
mutate(d = (mean1 - mean2) /
sqrt(((n1 - 1) * var1 + (n2 - 1) * var2) / (n1 + n2 - 2)),
d = abs(d)) |>
select(group1, group2, d)
}
perms <- map(1:10000, \(i) {
dat |>
break_assoc(group) |>
pairwise_cd(shuffled, y) |>
slice_max(d) |>
pull(d)
}) |>
list_c()

labs(title = "P-Value Inflation across 70 Comparisons",
subtitle = "Comparing correction aggressiveness by rank of significance",
x = "Comparison Rank (Most to Least Significant)",
y = "Adjusted P-Value") +
theme_minimal() +
scale_color_brewer(palette = "Set1")

View(basis_matrix)
engagement_trace(x,20)
engagement_trace <- function(xseq,
nknots,
coeffs = c(rnorm(nknots,0,1)),
offset = 0) {
basis_matrix <- bs(x, df = nknots)
y <- as.vector(basis_matrix %*% coeffs)
return(tibble(x = xseq,
rate = exp(-(y + offset))))
}

iqr_fence <- function(data) {
data %>%  mutate(across(everything(), function(x) {
q1 <- quantile(x, 0.25, na.rm = TRUE)
q3 <- quantile(x, 0.75, na.rm = TRUE)
iqr <- q3 - q1
lower <- q1 - 1.5 * iqr
upper <- q3 + 1.5 * iqr
ifelse(x < lower | x > upper, NA, x)
}))
}
dat_all %>% iqr_fence()

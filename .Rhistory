simulate_neuro_data <- function(n = 240, seed = NULL) {
tibble(id = sample(1000000:9999999,n)) %>%
mutate(
diagnosis = sample(
c("NT", "ASD"), size = n(),
replace = TRUE, prob = c(.65, .35)),
site = sample(str_c("Scanner_", LETTERS[1:3]),
size = n(), replace = TRUE),
sex = sample(c("Male", "Female"),
size = n(), replace = TRUE),
age = rnorm(n(),
mean = 11, sd = 2.5),
motion = rgamma(n(),
shape = 2,scale = 0.15),
latent_brain = rnorm(n()),
FA_uncinate_L = 0.20 * latent_brain + rnorm(n(), 0.45, .08),
FA_uncinate_R = 0.18 * latent_brain + rnorm(n(), 0.46, .08),
FA_cingulum = 0.16 * latent_brain + rnorm(n(), 0.48, .08),
FC_frontoparietal = 0.25 * latent_brain + rnorm(n(), 0, 0.25),
FC_DMN = -0.18 * latent_brain + rnorm(n(), 0, 0.3),
exec_score = 0.05 * FC_frontoparietal - 0.20 * motion + rnorm(n(), 0, 0.4),
working_memory = 0.03 * FA_cingulum - 0.15 * motion + rnorm(n(), 0, 0.4),
attention_score = 0.02 * FA_cingulum - 0.10 * motion + rnorm(n(), 0, 0.4)
) %>%
mutate(bad_scan = row_number() %in% sample(row_number(), size = round(n() * 0.06)),
motion = if_else(bad_scan, motion + runif(n(), 0.6, 1.5), motion),
FA_uncinate_L = if_else(bad_scan, FA_uncinate_L - rnorm(n(), .08, .04), FA_uncinate_L),
FC_frontoparietal = if_else(bad_scan, FC_frontoparietal + rnorm(n(), 0.5, 0.25), FC_frontoparietal)) %>%
select(-latent_brain, -bad_scan)
}

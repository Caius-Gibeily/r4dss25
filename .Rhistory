p_vals <- map(c(seq(1,10,2) %o% 10^(0:1)) |> rev(), \(n) {
p_hack_composite |>
group_by(iteration) |>
slice_sample(n=n, replace = FALSE) |>
mutate(smallest_p = if_else(p_chi < p_aov, p_chi, p_aov)) |>
reframe(
n_steps = n,
p_val = n / sum(1 / smallest_p))
}) |> list_rbind()
p_vals |>
ggplot(aes(x = p_val, group = as.factor(n_steps), fill = as.factor(n_steps))) +
geom_density(alpha = 0.2, bw = 0.08) +
geom_vline(xintercept=0.05, linewidth = 1.5) +
scale_fill_viridis_d() +
theme_minimal() +
guides(fill = guide_legend(title = "Number of analytic steps"))
